# Servidor web
PORT=8081

# Persistência oficial do analisador (SQLite no servidor)
# Na VPS, crie este diretório com permissão de escrita para o processo Node.
DATA_DIR=/var/lib/analisador
# DATABASE_PATH=/var/lib/analisador/analisador.sqlite

# Ollama na GPU, alcançado PELO BACKEND da VPS através do túnel SSH.
# O navegador nunca deve acessar esta porta diretamente.
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3.5:35b
OLLAMA_TEXT_MODEL=qwen3.5:35b
# O qwen3.5:35b instalado na GPU já expõe capability=vision; use o mesmo
# modelo para texto e visão neste ambiente.
OLLAMA_VISION_MODEL=qwen3.5:35b
# Timeout das chamadas de IA (5 min): um modelo de 35B na GPU pode demorar.
# Um timeout NUNCA destrói estado (candles, relógio, calibração) — ele é
# registrado como AI_TIMEOUT na Central de Erros e o pipeline não-IA continua.
OLLAMA_TIMEOUT_MS=300000
AI_TIMEOUT_MS=300000
OLLAMA_HEALTH_TIMEOUT_MS=5000
# OLLAMA_API_KEY=   # opcional; Ollama local normalmente não exige chave

# Compatibilidade com provedores OpenAI-compatible. Use apenas se não estiver
# usando as variáveis OLLAMA_* acima.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://seu-provedor.example/v1
# AI_MODEL=seu-modelo
# AI_VISION_MODEL=seu-modelo-visual
# AI_API_KEY=...
# AI_TIMEOUT_MS=120000
# AI_HEALTH_TIMEOUT_MS=5000

# ── CLAUDE ADMIN + CENTRAL DE ERROS (áreas /claude e /erros) ────────────────
# Token exigido para acessar /claude e gerenciar /erros. Sem ele o Claude
# Admin fica DESATIVADO. Nunca reutilize senhas.
# ADMIN_TOKEN=defina-um-token-forte

# Chave da API Anthropic — SOMENTE aqui no servidor. Ela nunca vai ao
# navegador, ao bundle JS nem aos logs (há sanitização automática).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Habilita os comandos whitelisted (test/typecheck/lint/build/git) que o
# Claude Admin pode rodar NA VPS. Desligado por padrão.
# CLAUDE_ADMIN_ALLOW_COMMANDS=1

# Raiz do projeto que o Claude Admin pode ler/alterar (padrão: cwd).
# CLAUDE_ADMIN_ROOT=/caminho/do/projeto

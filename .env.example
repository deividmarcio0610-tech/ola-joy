# Supabase (chaves publicáveis — podem ir para o cliente)
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ---------------------------------------------------------------------------
# Inferência no seu servidor vLLM (GPU na VPS, exposta por túnel).
# Nenhuma API de terceiros é usada. Nunca prefixe com VITE_: essas variáveis
# são lidas apenas no servidor e não devem ir para o bundle do browser.
# ---------------------------------------------------------------------------

# Obrigatória. Aceita com ou sem /v1 no final.
VLLM_BASE_URL="https://gpu.suavps.com/v1"

# Opcional: só se você subiu o vLLM com --api-key, ou se o túnel exige token.
VLLM_API_KEY=""

# Opcional: sem isso, o app usa o primeiro modelo anunciado em /v1/models.
VLLM_MODEL=""

# Opcional: tempo máximo de espera por geração, em ms (padrão 120000).
VLLM_TIMEOUT_MS=""

# --- Transcrição (Whisper na GPU) ---
# Opcional: se o Whisper roda em outra porta/instância, aponte aqui.
# Sem isso, usa a mesma URL do vLLM acima.
VLLM_STT_BASE_URL=""

# Opcional: id do modelo de transcrição. Sem isso, o app procura um modelo
# com "whisper" no nome entre os anunciados por /v1/models.
VLLM_STT_MODEL=""

# Opcional: chave só do servidor de transcrição (padrão: VLLM_API_KEY).
VLLM_STT_API_KEY=""

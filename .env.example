# =============================================================================
# Vision — variáveis de ambiente
#
# Copie para .env (NUNCA versione o .env real) e mantenha o arquivo em 600.
#
#   VITE_*      -> compiladas no bundle do navegador durante o BUILD.
#                  São públicas. Mudou uma? Precisa buildar de novo.
#   sem prefixo -> lidas em RUNTIME pelo servidor. São segredos.
#
# O /usr/local/bin/deploy-vision carrega este arquivo antes de reiniciar o PM2
# (`set -a; . "$APP/.env"; set +a`). Sem isso, todo process.env fica undefined
# e as server functions falham com "Missing Supabase environment variable(s)".
# =============================================================================

# --- Supabase (OBRIGATÓRIO) --------------------------------------------------
# Painel: https://supabase.com/dashboard/project/<REF>/settings/api

# Cliente (navegador). Protegidas por RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cole_a_publishable_anon_key
VITE_SUPABASE_PROJECT_ID=seu_project_ref

# Servidor. Mesmos valores, sem o prefixo VITE_.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=cole_a_publishable_anon_key
SUPABASE_PROJECT_ID=seu_project_ref

# SEGREDO — ignora RLS. Só no servidor, jamais com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key

# --- IA da VPS (OBRIGATÓRIO para ÍRIS, chat, análise de foto e vídeo) --------
# Sem estas duas, /api/vps/* responde "VISION_AI_API_URL não configurada"
# e as telas de IA ficam fora do ar.
# O client valida o host contra esta URL (allowlist anti-SSRF).
VISION_AI_API_URL=https://ia.seu-dominio.com
VISION_AI_API_KEY=cole_a_chave_da_api_de_ia

# Os nomes antigos continuam funcionando como fallback, para não quebrar ambientes
# que ainda os usem. Prefira os VISION_* acima.
# VALETECH_AI_API_URL=
# VALETECH_AI_API_KEY=

# --- Geração de imagem (Kaizen "DEPOIS") ------------------------------------
# O roteador em src/lib/image-providers tenta os providers configurados, na
# ordem definida na tabela image_providers, com circuit breaker por falha.
# Configure ao menos UM; os demais podem ficar vazios.
GEMINI_API_KEY=
OPENAI_API_KEY=
FAL_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=

# --- Notificações push (Web Push / VAPID) -----------------------------------
# Gere o par com:  npx web-push generate-vapid-keys
# Sem elas, o envio de push falha (a assinatura no navegador ainda funciona).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertas@seu-dominio.com

# --- Clima e descargas atmosféricas -----------------------------------------
# O clima usa Open-Meteo, que NÃO exige chave — já funciona sem configuração.
# Só defina se quiser apontar para outro host.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com
# OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com

# Contagem de raios. Padrão "disabled": o painel mostra o estado real, sem inventar dado.
# Valores possíveis: disabled | openweather | blitzortung
LIGHTNING_PROVIDER=disabled
OPENWEATHER_API_KEY=

# --- Runtime do servidor -----------------------------------------------------
# Injetados pelo deploy-vision; só defina aqui se rodar o app manualmente.
# PORT=3002
# HOST=127.0.0.1
# NODE_ENV=production
